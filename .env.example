# =============================================================================
# CampusCare — Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit .env to GitHub or version control!
# =============================================================================

# Database Connection
# Production (Render PostgreSQL, Neon, Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/campuscare?sslmode=require"
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Authentication (Minimum 32 characters for JWT security)
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Admin Registration Security Passkey
# Required when creating an Administrator account via /register
ADMIN_REGISTER_KEY="CampusCare2026AdminKey"

# Application Base URL
# Local: http://localhost:3000
# Production: https://your-campuscare-app.onrender.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Storage Driver (local | s3)
STORAGE_DRIVER="local"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""

# Optional Email Notification Service (SMTP)
EMAIL_SERVER=""
EMAIL_FROM="notifications@smartcampus.edu"

# Cloudflare Turnstile CAPTCHA (Bot Protection)
# Obtain Site Key & Secret Key from your Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
